<header class='item-header flexrow'>
  <img
    class='item-img'
    src='{{item.img}}'
    data-action='editImage'
    data-edit='img'
    data-tooltip='{{localize "NEONRELIC.Item.ImageHint"}}'
    title='{{item.name}}'
  />
  {{#if (eq itemType 'informationCard')}}
    {{#if item.img}}
      <button
        type='button'
        class='examine-photo'
        data-action='examinePhoto'
        data-tooltip='{{localize "NEONRELIC.InfoCard.ExaminePhotoHint"}}'
      >
        <i class='fa-solid fa-magnifying-glass-plus'></i>
        {{localize 'NEONRELIC.InfoCard.ExaminePhoto'}}
      </button>
    {{/if}}
  {{/if}}
  <div class='header-fields'>
    <h1>
      <input
        name='name'
        type='text'
        value='{{item.name}}'
        placeholder='{{localize "NEONRELIC.Item.Name"}}'
        {{disabled (not isEditable)}}
      />
    </h1>
    <span class='item-type'>{{localize (concat 'NEONRELIC.ItemType.' itemType)}}</span>
  </div>
</header>