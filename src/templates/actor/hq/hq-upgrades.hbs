<section class='tab upgrades {{tab.cssClass}}' data-group='primary' data-tab='upgrades'>
  <div class='upgrade-summary-bar'>
    <span class='summary-chip'>
      <i class='fa-solid fa-coins' inert></i>
      {{localize 'NEONRELIC.HQ.DP'}}:
      <b>{{system.dp}}</b>
    </span>
    <span class='summary-chip'>
      <i class='fa-solid fa-star' inert></i>
      {{localize 'NEONRELIC.HQ.Standing'}}:
      <b>{{system.standing}}</b>
      ({{standingRankLabel}})
    </span>
    <span class='summary-chip'>
      <i class='fa-solid fa-hammer' inert></i>
      {{localize 'NEONRELIC.HQ.Upgrades.SummaryHint'}}
    </span>
  </div>

  {{#each upgradeTiers}}
    <div class='upgrade-tier tier-{{this.tier}}'>
      <div class='tier-header'>
        <span class='tier-label'>{{localize this.label}}</span>
        <span class='tier-meta'>{{this.established}} / {{this.total}}</span>
        {{#if this.standingGate}}
          <span class='tier-gate'>
            {{localize 'NEONRELIC.HQ.Upgrades.RequiresStanding'}}
            {{this.standingGate}}
          </span>
        {{/if}}
      </div>

      {{#if this.items.length}}
        <div class='upgrade-cards'>
          {{#each this.items}}
            <div class='{{this.cardClass}}'>
              <div class='upgrade-card-header'>
                <img class='upgrade-img' src='{{this.img}}' alt='{{this.name}}' />
                <div class='upgrade-title-block'>
                  <span class='upgrade-name'>{{this.name}}</span>
                  <span class='upgrade-badges'>
                    <span class='badge cost'>{{this.dpCost}}
                      {{localize 'NEONRELIC.HQ.DP'}}</span>
                    {{#if this.specificStandingRequirement}}
                      <span class='badge standing'>{{localize 'NEONRELIC.HQ.Standing'}}
                        {{this.specificStandingRequirement}}+</span>
                    {{/if}}
                    <span class='badge category'>{{localize this.categoryLabel}}</span>
                  </span>
                </div>
                {{#if this.purchased}}
                  <span class='status-badge established'>
                    <i class='fa-solid fa-check' inert></i>
                    {{localize 'NEONRELIC.HQ.Upgrades.Established'}}
                  </span>
                {{/if}}
              </div>

              <p class='upgrade-description'>{{this.description}}</p>

              {{#if this.effect}}
                <div class='upgrade-effect'>
                  <i class='fa-solid fa-bolt' inert></i>
                  {{this.effect}}
                </div>
              {{/if}}

              {{#if this.hasPrerequisites}}
                <div class='upgrade-prereqs'>
                  {{localize 'NEONRELIC.HQ.Upgrades.Prerequisites'}}:
                  {{this.prereqText}}
                </div>
              {{/if}}

              <div class='upgrade-card-footer'>
                {{#if this.purchased}}
                  <span class='footer-note'>{{localize 'NEONRELIC.HQ.Upgrades.InPlace'}}</span>
                {{else if this.available}}
                  <button
                    type='button'
                    class='establish-btn'
                    data-action='purchaseUpgrade'
                    data-upgrade-id='{{this.id}}'
                    data-upgrade-name='{{this.name}}'
                  >
                    <i class='fa-solid fa-hammer' inert></i>
                    {{localize 'NEONRELIC.HQ.Upgrades.Establish'}}
                  </button>
                {{else}}
                  <span class='lock-note'>
                    <i class='fa-solid fa-lock' inert></i>
                    {{this.lockReasonText}}
                  </span>
                {{/if}}
              </div>
            </div>
          {{/each}}
        </div>
      {{/if}}
    </div>
  {{/each}}

  <p class='hint'>{{localize 'NEONRELIC.HQ.Upgrades.DropHint'}}</p>
</section>